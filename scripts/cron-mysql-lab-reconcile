# MySQL 实验平台：整点对账（到期回收 + 僵尸实例清理 + 端口租约归还）
# 安装：cp scripts/cron-mysql-lab-reconcile /etc/cron.d/mysql-lab-reconcile && chmod 644 $_
# 注意：/etc/cron.d/ 下的文件必须是 5 段时间表达式 + 用户 + 命令，
#       不能写 shebang（cron 会把 `#!/bin/sh` 当用户名字段解析并整行丢弃）。
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 解释器必须与部署时装依赖的那个一致：用 venv 部署就用 venv 的 python，
# 否则 cron 里 import fastapi/docker 全部失败，对账会静默失效（表现为实验单过期不回收）。
# 别用 `python3` / `python3.11` 这种泛称，PATH 在 cron 里和登录 shell 不同。
0 * * * * root cd /root/mysql-lab && /root/mysql-lab/venv/bin/python scripts/reconcile.py >> /var/log/mysql-lab-reconcile.log 2>&1
