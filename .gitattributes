# 部署到 Linux 的文件必须保持 LF：cron 配置若带 CRLF 会被 cron 静默丢弃
# （/etc/cron.d 里一行解析失败 → 整条定时任务消失，实验单永远不回收）
* text=auto

*.py            text eol=lf
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.md            text eol=lf
*.sql           text eol=lf
*.html          text eol=lf
*.txt           text eol=lf
deploy/*        text eol=lf
scripts/cron-*  text eol=lf
